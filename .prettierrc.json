{
  "printWidth": 110,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    { "files": ["*.md"], "options": { "printWidth": 96, "proseWrap": "always" } },
    { "files": ["*.yml", "*.yaml"], "options": { "printWidth": 100 } }
  ]
}
