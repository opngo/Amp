{
  "name": "@amp/desktop",
  "version": "0.9.0",
  "private": true,
  "description": "Amp desktop shell (Electron main + preload)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "music-metadata": "^11.0.0"
  },
  "devDependencies": {
    "@amp/core": "*",
    "electron": "44.4.2",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "author": {
    "name": "Amp contributors",
    "email": "amp@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/opngo/amp.git"
  },
  "desktopName": "amp",
  "engines": {
    "node": ">=22.12.0"
  }
}
